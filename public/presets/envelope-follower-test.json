  "description": "Audio envelope controls VCF cutoff via Envelope Follower module.",
  "group": "Module Tests",
  "graph": {
    "modules": [
      {
        "id": "ctrl-1",
        "type": "control",
        "name": "Control",
        "position": { "col": 1, "row": 1 },
        "params": {
          "cv": 0,
          "cvMode": "unipolar",
          "velocity": 1,
          "midiVelocity": true,
          "gate": 0,
          "glide": 0.02,
          "voices": 4
        }
      },
      {
        "id": "osc-1",
        "type": "oscillator",
        "name": "VCO",
        "position": { "col": 4, "row": 1 },
        "params": {
          "frequency": 220,
          "type": "sawtooth",
          "pwm": 0.5
        }
      },
      {
        "id": "adsr-1",
        "type": "adsr",
        "name": "ADSR",
        "position": { "col": 6, "row": 1 },
        "params": {
          "attack": 0.01,
          "decay": 0.3,
          "sustain": 0.6,
          "release": 0.4
        }
      },
      {
        "id": "gain-1",
        "type": "gain",
        "name": "VCA",
        "position": { "col": 7, "row": 1 },
        "params": { "gain": 0.8 }
      },
      {
        "id": "envf-1",
        "type": "envelope-follower",
        "name": "Env Follow",
        "position": { "col": 8, "row": 1 },
        "params": {
          "attack": 0.005,
          "release": 0.15,
          "gain": 2.0
        }
      },
      {
        "id": "vcf-1",
