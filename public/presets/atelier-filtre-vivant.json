      { "id": "modosc", "type": "oscillator", "name": "Modulateur filtre", "position": { "x": 40, "y": 320 }, "params": { "frequency": 75, "type": "sine", "pwm": 0.5, "unison": 1, "detune": 0, "fmLin": 0, "fmExp": 0, "subMix": 0, "subOct": 1 } },
      { "id": "lfo", "type": "lfo", "name": "Balayage lent", "position": { "x": 40, "y": 560 }, "params": { "rate": 0.08, "depth": 0.5, "offset": 0, "shape": "sine", "bipolar": true } },
