{
  "version": 1,
  "id": "sampler-demo",
  "name": "Sampler — Load Your Own",
  "description": "Pitched one-shot .wav player triggered by a step sequencer. Load any sample (a drum hit, a vocal, a stab) and it plays in rhythm.",
  "group": "Sampler",
  "graph": {
    "modules": [
      {
        "id": "seq-1",
        "type": "step-sequencer",
        "name": "Trigger Seq",
        "position": { "x": 0, "y": 0 },
        "params": {
          "enabled": true,
          "tempo": 110,
          "rate": 4,
          "gateLength": 60,
          "swing": 8,
          "slideTime": 0,
          "length": 16,
          "direction": 0,
          "stepData": "[{\"pitch\":0,\"gate\":true,\"velocity\":100,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":55,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":80,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":50,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":100,\"slide\":false},{\"pitch\":0,\"gate\":false,\"velocity\":100,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":75,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":60,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":100,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":55,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":85,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":50,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":100,\"slide\":false},{\"pitch\":0,\"gate\":false,\"velocity\":100,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":90,\"slide\":false},{\"pitch\":0,\"gate\":true,\"velocity\":65,\"slide\":false}]"
        }
