{
  "id": "atelier-auto-ecoute",
  "name": "Atelier — Auto-Écoute",
  "description": "Le filtre qui s'écoute : sa propre sortie passe dans un envelope-follower qui ouvre sa coupure. Chaque pluck rythmique (Euclidean) fait \"wah\" tout seul — boucle de modulation maîtrisée.",
  "group": "Atelier Signal",
  "graph": {
    "modules": [
      { "id": "clk", "type": "clock", "name": "Clock", "position": { "x": 40, "y": 60 }, "params": { "running": true, "tempo": 100, "rate": 4, "swing": 0 } },
      { "id": "euclid", "type": "euclidean", "name": "Rythme", "position": { "x": 40, "y": 320 }, "params": { "enabled": true, "tempo": 100, "rate": 4, "steps": 16, "pulses": 7, "rotation": 0, "gateLength": 25, "swing": 0 } },
      { "id": "osc", "type": "oscillator", "name": "Source", "position": { "x": 460, "y": 60 }, "params": { "frequency": 110, "type": "sawtooth", "pwm": 0.5, "unison": 1, "detune": 0, "fmLin": 0, "fmExp": 0, "subMix": 0.2, "subOct": 1 } },
      { "id": "adsr", "type": "adsr", "name": "Enveloppe ampli", "position": { "x": 460, "y": 320 }, "params": { "attack": 0.005, "decay": 0.18, "sustain": 0.0, "release": 0.15 } },
